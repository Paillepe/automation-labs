{
  "name": "reservations",
  "version": "1.0.0",
  "private": true,
  "description": "Service de réservation des médiathèques de Valmorin (application fil rouge du cours)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "pretest": "node -e \"process.getBuiltinModule('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0"
  }
}
